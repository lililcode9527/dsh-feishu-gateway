# ============ DeepSeek Harness ============
# 本地 DSH 服务地址（保持默认即可；若端口不同请改）
DSH_BASE_URL=http://127.0.0.1:3080

# ============ 飞书开放平台 ============
# 方式一（单机器人）：直接在下面填 App ID / App Secret
# 方式二（多机器人/多工作区）：复制 bots.example.json 为 bots.json 并填写多个机器人，
#   此时忽略下面的 FEISHU_APP_ID / FEISHU_APP_SECRET
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 单机器人模式下机器人的名字（用于工作区命名，如 "飞书-default"）
DSH_BOT_NAME=default

# 允许使用机器人的用户（飞书 open_id，逗号分隔）。
# 留空 = 不限制（有 App Secret 就能连，建议生产环境务必填写）。
ALLOWED_OPEN_IDS=

# ============ 网关行为 ============
# 会话映射持久化文件（open_id -> dsh sessionId）
SESSIONS_FILE=./data/sessions.json
# 机器人会话的工作目录（留空 = 使用 DSH 默认目录）
DSH_SESSION_CWD=
# 单条回复最大字符数（超出截断）
MAX_REPLY_CHARS=4000
# 任务进行中进度通知的最小间隔（毫秒），避免刷屏
PROGRESS_THROTTLE_MS=10000
# 一轮任务最长等待时间（毫秒），超时发部分结果
TURN_TIMEOUT_MS=1800000
