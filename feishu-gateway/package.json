{
  "name": "dsh-feishu-gateway",
  "version": "0.1.0",
  "description": "Bridge Feishu (Lark) chats with your local DeepSeek Harness: long-connection bot (no public URL), phone chat with tasks, approvals (card buttons), questions, progress pings, image & file delivery. Runs as a standalone process via DSH's public /api.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "dsh-feishu-gateway": "bin/dsh-feishu-gateway.js"
  },
  "files": [
    "bin",
    "src",
    "scripts",
    "README.md",
    "LICENSE",
    ".env.example"
  ],
  "keywords": [
    "dsh",
    "deepseek-harness",
    "feishu",
    "lark",
    "bot",
    "mobile",
    "gateway"
  ],
  "scripts": {
    "start": "node src/index.js",
    "smoke": "node src/smoke.js",
    "check": "node src/check.js",
    "verify": "node src/verify.js",
    "setup": "node src/setup.js",
    "test": "node test/relay.test.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.73.0"
  }
}
